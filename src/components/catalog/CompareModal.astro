---
const { L } = Astro.props;
---
<div class="cmpmodal" id="cmpmodal" role="dialog" aria-modal="true" aria-labelledby="cmpTitle">
  <div class="ov" id="cmpOv"></div>
  <div class="cmppanel">
    <div class="cmphead">
      <h2 id="cmpTitle" data-i18n="compare">{L.compare}</h2>
      <button class="cmpx" id="cmpClose" data-i18n-aria="a_close" aria-label={L.a_close}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    </div>
    <div class="cmpscroll" id="cmpBody"></div>
  </div>
</div>
