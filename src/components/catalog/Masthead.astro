---
const { L, meta } = Astro.props;
---
<header class="mast">
  <div class="wrap mast-in">
    <div class="mast-kicker" data-i18n="kicker">{L.kicker}</div>
    <h1 class="mast-title" data-i18n="mast_title">{L.mast_title}</h1>
    <p class="mast-dek" data-i18n="dek">{L.dek}</p>
    <p class="mast-meta" id="meta" set:html={meta}></p>
  </div>
</header>
