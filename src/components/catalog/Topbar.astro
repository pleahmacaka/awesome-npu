---
const { L } = Astro.props;
---
<header class="topbar" id="topbar">
  <div class="wrap topbar-in">
    <a href="#top" class="wm">Awesome NPU</a>
    <nav class="tnav">
      <a href="#explorer" id="navProducts" data-i18n="nav_products">{L.nav_products}</a>
      <a href="#raspberry-pi-accelerators" data-i18n="nav_rpi">{L.nav_rpi}</a>
      <a href="#software" data-i18n="nav_software">{L.nav_software}</a>
      <a href="#glossary" data-i18n="nav_glossary">{L.nav_glossary}</a>
    </nav>
    <div class="tb-r">
      <a href="#news" id="navNews" class="tnews" data-i18n="nav_news">{L.nav_news}</a>
      <a href="https://pleahmacaka.github.io/awesome-npu/trends/" id="navCharts" class="tnews" data-i18n="nav_charts">{L.nav_charts}</a>
      <select id="langSel" class="langsel" data-i18n-aria="a_language" aria-label={L.a_language}></select>
      <a id="repoLink" class="ibtn" href="#" target="_blank" rel="noopener" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.34 9.34 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/></svg></a>
      <button id="themeBtn" class="ibtn" data-i18n-aria="a_theme" aria-label={L.a_theme}></button>
    </div>
  </div>
</header>
