---
import { LANGS } from '../../../scripts/render.mjs';
import CatalogApp from '../../components/catalog/CatalogApp.astro';
export function getStaticPaths() {
  return LANGS.filter(l => l !== 'en').map(lang => ({ params: { lang } }));
}
const { lang } = Astro.params;
---
<CatalogApp lang={lang} />
